# ---------------------------------------------------------------
# Lancashire Ladies Renovations — environment variables
# Copy this file to .env.local for local development, and add the
# same values in Vercel → Project → Settings → Environment Variables.
# ---------------------------------------------------------------

# Public site URL (used for SEO, sitemap and social sharing)
NEXT_PUBLIC_SITE_URL=https://www.lancashireladiesrenovations.co.uk

# --- Enquiry forms (REQUIRED for forms to send) -----------------
# Forms are delivered by email via Resend (https://resend.com).
# 1. Create a free Resend account and verify your sending domain.
# 2. Create an API key and paste it below.
RESEND_API_KEY=
# The inbox that should receive enquiries (e.g. Laura's email)
ENQUIRY_TO_EMAIL=
# A sender address on your verified domain
ENQUIRY_FROM_EMAIL="Lancashire Ladies Renovations <enquiries@yourdomain.co.uk>"

# --- Spam protection (OPTIONAL but recommended) -----------------
# Honeypot + timing checks are always on. For stronger protection
# add Cloudflare Turnstile keys (https://dash.cloudflare.com → Turnstile).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics (OPTIONAL) ---------------------------------------
# Google Analytics 4 measurement ID. Only loads after a visitor
# accepts analytics cookies.
NEXT_PUBLIC_GA_ID=
